    "version": "4.0.26255.346",
    "description": "A powerful, multi-purpose tool that helps you monitor system resources, debug software and detect malware.",
    "homepage": "https://systeminformer.sourceforge.io",
    "license": "MIT",
    "architecture": {
        "32bit": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26255.346/systeminformer-build-win32-bin.zip",
            "hash": "633422cf5db79f45eaadb3f35ab98722bef901b9c9ab2ccf4f3dc349af9a55f6"
        },
        "64bit": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26255.346/systeminformer-build-win64-bin.zip",
            "hash": "5a6df92d4a79706ed3ca0c412b742388fb49f84a5ea4440227c7cac7b1e18b55"
        },
        "arm64": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26255.346/systeminformer-build-arm64-bin.zip",
            "hash": "5f4cb35409bea9e38640eb6ae58aa5c4e9c993306565cf7fa01a5fd49df07cfd"
        }
    },
    "pre_install": [
        "'SystemInformer.exe.settings.json', 'peview.exe.settings.json', 'usernotesdb.json' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\") {",
        "        Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\"",
        "    } else {",
        "        Set-Content \"$dir\\$_\" -Value \"{}\" | Out-Null",
        "    }",
        "}",
        "if (-not (Test-Path \"$persist_dir\\scan.db\")) {",
        "    New-Item \"$dir\\scan.db\" | Out-Null",
        "}"
    ],
    "bin": "peview.exe",
    "shortcuts": [
        [
            "SystemInformer.exe",
            "System Informer"
        ],
        [
            "peview.exe",
            "PE Viewer"
        ]
    ],
    "persist": "scan.db",
    "pre_uninstall": [
        "ensure $persist_dir",
        "'SystemInformer.exe.settings.json', 'peview.exe.settings.json', 'usernotesdb.json' | ForEach-Object {",
        "    Copy-Item \"$dir\\$_\" \"$persist_dir\\$_\"",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/winsiderss/si-builds"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-win32-bin.zip"
            },
            "64bit": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-win64-bin.zip"
            },
            "arm64": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-arm64-bin.zip"
            }
        }
    }
}
