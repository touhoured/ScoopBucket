{
    "version": "0.4.1",
    "description": "Scoop shim launcher (Rust implementation). Runs the executable described in its paired .shim file.",
    "homepage": "https://github.com/ScoopInstaller/Shim",
    "license": "Unlicense OR MIT",
    "notes": [
        "Scoop core has no support for the new shim implementations yet, so this manifest overwrites every built-in Scoop shim (supporting\\shims\\71, kiennq and scoopcs).",
        "Whatever 'scoop config shim' is set to (or the default kiennq), Scoop will use this implementation.",
        "Install only one of scoop-shim-cs, scoop-shim-cpp, scoop-shim-rust or scoop-shim-zig at a time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v0.4.1/shim-x64.zip",
            "hash": "14faad4e5f61152478d6933d85211599eb7f59b36b2a34bee64d3c7e82eb8361"
        },
        "32bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v0.4.1/shim-x86.zip",
            "hash": "ca48ac36962afe34c0b38b779871bfd4e7d65c8565c5bb1bb61a58b2e3b70eff"
        },
        "arm64": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v0.4.1/shim-arm64.zip",
            "hash": "f799b311775a15bddf6c46c681f550488f5c0f0dc5406bfe67aeaf962f0c6741"
        }
    },
    "post_install": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "Copy-Item \"$dir\\shim.exe\" \"$scoopdir\\apps\\scoop\\current\\supporting\\shims\\$shimBuild\\shim.exe\" -Force",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "pre_uninstall": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --no-skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\"",
        "git -C \"$scoopdir\\apps\\scoop\\current\" checkout -- \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ScoopInstaller/Shim/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "rust/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v$version/shim-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v$version/shim-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/rust/v$version/shim-arm64.zip"
            }
        }
    }
}
