{
    "version": "18.3.0.0",
    "description": "A free to use bangumi player with danmaku support.",
    "homepage": "https://www.dandanplay.com/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kaedei/dandanplay/releases/download/windows-18.3.0.0/dandanplay-x64_18.3.0.zip",
            "hash": "1cdb00bc1fb6ff4a3b0efb10ca4291ed57f738f3ab65544349f8b026b1d40e1a",
            "extract_dir": "dandanplay-x64"
        }
    },
    "pre_install": [
        "ensure \"$persist_dir\\Config\" ",
        "# Disable auto update",
        "if (!(Test-Path \"$persist_dir\\Config\\ConnectionSettings.xml\")) {",
        "    New-Item \"$persist_dir\\Config\\ConnectionSettings.xml\" -ItemType File -Value '<?xml version=\"1.0\"?><ConnectionSettings><EnableAutoUpdate>false</EnableAutoUpdate><NotifyOnUpdateDownloaded>false</NotifyOnUpdateDownloaded></ConnectionSettings>' | Out-Null",
        "}",
        "# Disable telemetry",
        "if (!(Test-Path \"$persist_dir\\Config\\UserSettings.xml\")) {",
        "    New-Item \"$persist_dir\\Config\\UserSettings.xml\" -ItemType File -Value '<?xml version=\"1.0\"?><UserSettings><EnableTelemetry>false</EnableTelemetry></UserSettings>' | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "dandanplay.exe",
            "dandanplay"
        ]
    ],
    "persist": [
        "Cache",
        "Config",
        "Log"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/kaedei/dandanplay/releases",
        "regex": "windows-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kaedei/dandanplay/releases/download/windows-$version/dandanplay-x64_$matchHead.zip",
                "extract_dir": "dandanplay-x64"
            }
        }
    }
}
