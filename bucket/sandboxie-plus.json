{
    "version": "1.18.3",
    "description": "An enhanced edition of Sandboxie that provides sandbox-based application isolation on Windows with additional features and a modern interface.",
    "homepage": "https://sandboxie-plus.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://github.com/sandboxie-plus/Sandboxie/blob/HEAD/LICENSE.Plus"
    },
    "notes": [
        "If the uninstall/update prompts SbieDrv/SbieSvc is still running, click",
        "Sandbox > Maintenance > Uninstall All"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/sandboxie-plus/Sandboxie/releases/download/v1.18.3/Sandboxie-Plus-x64-v1.18.3.exe",
            "hash": "9c269e1a1917806c4a59d59034b2f75caddfeef7994bdc681c0ba4132a9da130"
        },
        "arm64": {
            "url": "https://github.com/sandboxie-plus/Sandboxie/releases/download/v1.18.3/Sandboxie-Plus-ARM64-v1.18.3.exe",
            "hash": "43b33e4873a7d05d9f0acceb8d177c56bb398fff992f8ff0b00ad23bdf4f745d"
        }
    },
    "innosetup": true,
    "pre_install": [
        "ensure $persist_dir",
        "if (Test-Path \"$persist_dir\\Sandboxie-Plus.ini\") {",
        "    Copy-Item \"$persist_dir\\Sandboxie-Plus.ini\" \"$dir\\Sandboxie-Plus.ini\"",
        "} else {",
        "    New-Item \"$dir\\Sandboxie-Plus.ini\"",
        "}"
    ],
    "bin": [
        "SandMan.exe",
        [
            "start.exe",
            "sandboxie-start"
        ]
    ],
    "shortcuts": [
        [
            "SandMan.exe",
            "Sandboxie-Plus"
        ],
        [
            "Start.exe",
            "Sandboxie Start Menu",
            "/box:__ask__ start_menu"
        ],
        [
            "Start.exe",
            "Run any program sandboxed",
            "/box:__ask__ run_dialog"
        ],
        [
            "Start.exe",
            "Run Web browser sandboxed",
            "default_browser"
        ]
    ],
    "persist": "Sandboxie.ini",
    "pre_uninstall": [
        "ensure $persist_dir",
        "Copy-Item \"$dir\\Sandboxie-Plus.ini\" \"$persist_dir\\Sandboxie-Plus.ini\"",
        "# Stop-Process -Name 'SandMan' -Force -ErrorAction SilentlyContinue",
        "Start-Process \"$dir\\KmdUtil.exe\" -ArgumentList 'scandll_silent' -Wait -Verb RunAs",
        "Start-Process \"$dir\\KmdUtil.exe\" -ArgumentList @('stop', 'SbieSvc') -Wait -Verb RunAs",
        "Start-Process \"$dir\\KmdUtil.exe\" -ArgumentList @('stop', 'SbieDrv') -Wait -Verb RunAs",
        "Start-Process \"$dir\\KmdUtil.exe\" -ArgumentList @('delete', 'SbieSvc') -Wait -Verb RunAs",
        "Start-Process \"$dir\\KmdUtil.exe\" -ArgumentList @('delete', 'SbieDrv') -Wait -Verb RunAs"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/sandboxie-plus/Sandboxie/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sandboxie-plus/Sandboxie/releases/download/v$version/Sandboxie-Plus-x64-v$version.exe"
            },
            "arm64": {
                "url": "https://github.com/sandboxie-plus/Sandboxie/releases/download/v$version/Sandboxie-Plus-ARM64-v$version.exe"
            }
        }
    }
}
